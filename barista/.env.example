# Copy to .env.local and edit as needed. Vite reads VITE_* vars at dev/build
# time. Restart `npm run dev` after changes.

# Where the URL/upload bar POSTs taste requests. Default: local uvicorn.
# Override to point at a teammate's machine, an ngrok tunnel, or a deploy.
# VITE_TASTE_API_URL=http://localhost:8000
